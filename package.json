{
  "name": "homebridge-notify-switch",
  "displayName": "Notify Switch",
  "type": "module",
  "version": "0.1.0-beta.3",
  "description": "Homebridge switches that send SMS, email, or Telegram messages when turned on. Trigger them from HomeKit automations and scenes.",
  "author": "arodbuilds",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arodbuilds/homebridge-notify-switch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/arodbuilds/homebridge-notify-switch.git"
  },
  "bugs": {
    "url": "https://github.com/arodbuilds/homebridge-notify-switch/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "notification",
    "notify",
    "sms",
    "twilio",
    "email",
    "smtp",
    "telegram",
    "switch"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "homebridge-ui/public",
    "homebridge-ui/server.js",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && npm run build:ui",
    "build:ui": "tsc -p homebridge-ui --noEmit && node scripts/build-ui.mjs",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run build && node --test \"test/harness/*.test.mjs\"",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "libphonenumber-js": "^1.13.12",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.63.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "nodemailer": "^10.0.0"
  }
}
