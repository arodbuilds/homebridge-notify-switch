{
  "platform": "NotifySwitch",
  "name": "Notify Switch",
  "configVersion": 1,
  "defaultCountry": "US",
  "timeFormat": "12h",
  "dateFormat": "mdy",
  "masterSwitch": {
    "enabled": true,
    "name": "Notifications Enabled"
  },
  "debug": false,
  "providers": [
    {
      "id": "twilio-main",
      "type": "twilio",
      "name": "Twilio",
      "accountSid": "AC00000000000000000000000000000000",
      "apiKeySid": "SK00000000000000000000000000000000",
      "apiKeySecret": "secret-api-key-value",
      "smsSenders": [
        "+16785550100"
      ]
    },
    {
      "id": "fastmail",
      "type": "smtp",
      "name": "Fastmail",
      "host": "smtp.fastmail.com",
      "port": 465,
      "security": "ssl",
      "username": "alex@example.com",
      "password": "app-password-value",
      "from": {
        "address": "alex@example.com",
        "name": "Home"
      }
    }
  ],
  "groups": [
    {
      "id": "family",
      "name": "Family",
      "sms": [
        "+16785550101",
        "+16785550102"
      ],
      "email": [
        "a@example.com"
      ],
      "telegram": [
        "123456789"
      ],
      "ntfy": [
        "home-alerts"
      ]
    }
  ],
  "switches": [
    {
      "id": "6f1c2a9e-2b1c-4b8f-9d1e-0c5a1e2f3a4b",
      "name": "Garage",
      "enabled": true,
      "cooldownSeconds": 0,
      "failureMode": "any",
      "failureSensor": false,
      "failureSensorResetSeconds": 300,
      "actions": [
        {
          "providerId": "fastmail",
          "channel": "email",
          "groups": [
            "family"
          ],
          "recipients": [],
          "body": "Garage open."
        },
        {
          "providerId": "twilio-main",
          "channel": "sms",
          "groups": [
            "family"
          ],
          "recipients": [],
          "body": "Garage open."
        }
      ]
    },
    {
      "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
      "name": "Extras only",
      "enabled": true,
      "cooldownSeconds": 0,
      "failureMode": "any",
      "failureSensor": false,
      "failureSensorResetSeconds": 300,
      "actions": [
        {
          "providerId": "fastmail",
          "channel": "email",
          "groups": [],
          "recipients": [
            "solo@example.com"
          ],
          "body": "Hello"
        }
      ]
    }
  ]
}
