{
  "platform": "NotifySwitch",
  "name": "Notify Switch",
  "configVersion": 1,
  "defaultCountry": "US",
  "masterSwitch": {
    "enabled": true,
    "name": "Notifications Enabled"
  },
  "debug": false,
  "providers": [
    {
      "id": "twilio-main",
      "type": "twilio",
      "name": "Twilio",
      "accountSid": "AC00000000000000000000000000000000",
      "apiKeySid": "SK00000000000000000000000000000000",
      "apiKeySecret": "secret-api-key-value",
      "smsSenders": [
        "+16785550100"
      ]
    },
    {
      "id": "fastmail",
      "type": "smtp",
      "name": "Fastmail",
      "host": "smtp.fastmail.com",
      "port": 465,
      "security": "ssl",
      "username": "alex@example.com",
      "password": "app-password-value",
      "from": {
        "address": "alex@example.com",
        "name": "Home"
      }
    },
    {
      "id": "telegram-home",
      "type": "telegram",
      "name": "Telegram",
      "botToken": "123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "parseMode": "none"
    },
    {
      "id": "ntfy-home",
      "type": "ntfy",
      "name": "ntfy",
      "server": "https://ntfy.sh",
      "auth": "token",
      "token": "tk_secret_access_token_value"
    }
  ],
  "groups": [
    {
      "id": "family",
      "name": "Family",
      "sms": [
        "+16785550101",
        "+16785550102"
      ],
      "email": [
        "a@example.com"
      ],
      "telegram": [
        "123456789"
      ],
      "ntfy": [
        "home-alerts"
      ]
    },
    {
      "id": "neighbours",
      "name": "Neighbours",
      "sms": [],
      "email": [
        "n@example.com"
      ],
      "telegram": [],
      "ntfy": []
    }
  ],
  "switches": [
    {
      "id": "6f1c2a9e-2b1c-4b8f-9d1e-0c5a1e2f3a4b",
      "name": "Water Leak Alert",
      "enabled": true,
      "cooldownSeconds": 0,
      "failureMode": "any",
      "failureSensor": false,
      "failureSensorResetSeconds": 300,
      "actions": [
        {
          "providerId": "twilio-main",
          "channel": "sms",
          "groups": [
            "family",
            "neighbours"
          ],
          "recipients": [],
          "body": "Water at {{time}}."
        },
        {
          "providerId": "fastmail",
          "channel": "email",
          "groups": [
            "family",
            "neighbours"
          ],
          "recipients": [],
          "subject": "Leak",
          "body": "Water at {{time}}."
        },
        {
          "providerId": "telegram-home",
          "channel": "telegram",
          "groups": [
            "family",
            "neighbours"
          ],
          "recipients": [],
          "body": "Water at {{time}}."
        },
        {
          "providerId": "ntfy-home",
          "channel": "ntfy",
          "groups": [
            "family",
            "neighbours"
          ],
          "recipients": [],
          "subject": "Leak",
          "body": "Water at {{time}}."
        }
      ]
    }
  ]
}
